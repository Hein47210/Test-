--- FEATURE 3: Instant Proximity Prompt
--- ==========================================
local originalHoldTimes = {}

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if States.InstantPrompt then
        -- Store original time if not already stored
        if not originalHoldTimes[prompt] then
            originalHoldTimes[prompt] = prompt.HoldDuration
        end
        prompt.HoldDuration = 0
    end
end)

CreateToggle("Instant Prompt", 3, function(state)
    States.InstantPrompt = state
    if not state then
        -- Restore original hold times when turned off
        for prompt, duration in pairs(originalHoldTimes) do
            if prompt and prompt.Parent then
                prompt.HoldDuration = duration
            end
        end
    end
end)

--- ==========================================
--- FEATURE 4: NPC / Enemy Kill Aura Frame
--- ==========================================
-- NOTE: This attempts to fire an animation or tool click if equipped. 
-- In a private test environment, replace the tool activation logic with your custom combat remote event if necessary.
local AURA_RANGE = 15 

RunService.RenderStepped:Connect(function()
    if not States.KillAura then return end
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local tool = character and character:FindFirstChildOfClass("Tool")
    
    if not rootPart or not tool then return end

    -- Search workspace for targets (both Players and NPCs with Humanoids)
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Parent ~= character then
            local enemyRoot = desc.Parent:FindFirstChild("HumanoidRootPart")
            if enemyRoot and desc.Health > 0 then
                local distance = (rootPart.Position - enemyRoot.Position).Magnitude
                if distance <= AURA_RANGE then
                    -- Simulates clicking with a weapon tool equipped
                    tool:Activate()
                    break -- Actuating once per frame prevents frame drops
                end
            end
        end
    end
end)

CreateToggle("Kill Aura", 4, function(state)
    States.KillAura = state
end)
