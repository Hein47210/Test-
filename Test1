--- ==========================================
--- FEATURE 2: ESP (Box Highlight)
--- ==========================================
local function applyESP(player)
    if player == LocalPlayer then return end
    
    local function setupCharacter(char)
        if char:FindFirstChild("PlayerESP") then return end
        
        local Box = Instance.new("BoxHandleAdornment")
        Box.Name = "PlayerESP"
        Box.Size = Vector3.new(4, 6, 4)
        Box.Color3 = Color3.fromRGB(255, 0, 50)
        Box.AlwaysOnTop = true
        Box.ZIndex = 5
        Box.Transparency = 0.5
        Box.Adornee = char:WaitForChild("HumanoidRootPart", 5)
        Box.Parent = char
        
        -- Keep hidden if feature is toggled off
        Box.Visible = States.ESP
    end

    if player.Character then setupCharacter(player.Character) end
    player.CharacterAdded:Connect(setupCharacter)
end

local function toggleESP(state)
    States.ESP = state
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local box = p.Character:FindFirstChild("PlayerESP")
            if box then box.Visible = state end
        end
    end
end

-- Initialize ESP for current and new players
for _, p in ipairs(Players:GetPlayers()) do applyESP(p) end
Players.PlayerAdded:Connect(applyESP)

CreateToggle("Simple ESP", 2, toggleESP)

